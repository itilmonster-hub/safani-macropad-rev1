#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/* Definisi nomor layer */
#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3
#define BLT 4

/ {
    keymap {
        compatible = "zmk,keymap";

        /* ================= LAYER 0 (SAFANI) ================= */
        default_layer {
            display-name = "SAFANI";

            bindings = <
                &kp ESC              &kp UP_ARROW       &none
                &kp LEFT_ARROW       &kp C_PLAY_PAUSE   &kp RIGHT_ARROW
                &none                &kp DOWN_ARROW     &none
                &to LWR     /* Tekan encoder -> pindah ke Layer 1 */
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };

        /* ================= LAYER 1 (LOWER) ================= */
        lower_layer {
            display-name = "MEDIA";

            bindings = <
                &kp N0           &kp C_VOL_UP      &kp N2
                &kp C_PREV      &kp C_PLAY_PAUSE  &kp C_NEXT
                &kp N5           &kp C_VOL_DN      &kp N8
                &to RSE     /* Tekan encoder -> pindah ke Layer 2 */
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };

        /* ================= LAYER 2 (RAISE) ================= */
        raise_layer {
            display-name = "NUM";

            bindings = <
                &kp N1    &kp N2      &kp N3
                &kp N4    &kp N5      &kp N6
                &kp N7    &kp N8      &kp N9
                &to ADJ     /* Tekan encoder -> pindah ke Layer 3 */
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };

        /* ================= LAYER 3 (ADJUST) ================= */
        adjust_layer {
            display-name = "WINDOWS";

            bindings = <
                &kp LC(C)       &kp LC(X)       &kp LC(V)
                &kp LCTRL       &kp RET       &kp LC(LA(DEL))
                &kp RALT       &kp TAB       &kp LA(TAB)
                &to BLT     /* Tekan encoder -> pindah ke Layer 4 */
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };

        /* ================= LAYER 4 (BLUETOOTH) ================= */
        adjust_layer {
            display-name = "BLUETOOTH";

            bindings = <
                &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2
                &bt BT_SEL 3       &bt BT_SEL 4       &bt BT_SEL 5
                &none       &none       &none
                &to DEF     /* Tekan encoder -> kembali ke Layer 0 (SAFANI) */
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };
    };
};
